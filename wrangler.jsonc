{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The game, as static files (`pnpm run deploy`): the Vite build in dist/.
  "name": "botbtc-drill",
  "compatibility_date": "2026-09-30",
  "assets": { "directory": "./dist" },
  // Served only on its custom domain: no workers.dev or preview addresses,
  // which carry the account's subdomain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "drill.botbtc.fun", "custom_domain": true }]
}
